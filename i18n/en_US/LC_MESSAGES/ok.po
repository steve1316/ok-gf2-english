msgid "最后阶段检测到继续前进，点击后开启新一轮自动战斗"
msgstr ""
"Continue detected in the final phase, clicking it to begin another auto-"
"battle round."

msgid "未获取到 hwnd，无法终止游戏进程"
msgstr "No window handle found, cannot stop the game process."

msgid "未获取到 hwnd 属性，无法终止游戏进程"
msgstr "No window handle attribute found, cannot stop the game process."

msgid "闪耀星愿未找到开始作战和一键领取，尝试跳过对话框后重试"
msgstr ""
"Could not find Start Battle or Claim All in the event bonus stages, skipping"
" dialogs and retrying."

msgid "自主循环步骤4未完成，退出循环"
msgstr "Start Loop step 4 did not finish, leaving the loop."

msgid "拂晓之光补给包奖励"
msgstr "Daybreak Supply Pack reward"

msgid "远航巡录领取时自动选择的补给包奖励，默认数据链路"
msgstr ""
"Reward selected automatically from the patrol supply pack; defaults to Data "
"Link."

